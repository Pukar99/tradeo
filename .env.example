# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Backend API URL
# Local dev: http://localhost:5000
# Production (Vercel): leave empty or set to "" — API calls proxy through Vercel via vercel.json rewrites
#   This fixes Safari ITP blocking cross-site cookies (iPhone login).
#   The /api/* rewrite in vercel.json forwards to the Render backend automatically.
VITE_API_URL=
